(kicad_pcb (version 20171130) (host pcbnew)
  (net 0 "")
  (net 1 GND)
  (net 2 FB)
  (net 3 OUT)

  (module Test:LoopInjector (layer F.Cu)
    (at 0 0)
    (fp_text reference VLOOP (at 0 -1) (layer F.SilkS))
    (fp_text value AC_LOOP_INJECTOR (at 0 1) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (size 1 1) (layers F.Cu)
      (net 2 FB))
    (pad 2 smd rect (at 1 0) (size 1 1) (layers F.Cu)
      (net 1 GND))
  )

  (module Test:ErrorAmp (layer F.Cu)
    (at 4 0)
    (fp_text reference U1 (at 0 -1) (layer F.SilkS))
    (fp_text value AC_ERRAMP (at 0 1) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (size 1 1) (layers F.Cu)
      (net 3 OUT))
    (pad 2 smd rect (at 1 0) (size 1 1) (layers F.Cu)
      (net 2 FB))
    (pad 3 smd rect (at 2 0) (size 1 1) (layers F.Cu)
      (net 1 GND))
  )
)
