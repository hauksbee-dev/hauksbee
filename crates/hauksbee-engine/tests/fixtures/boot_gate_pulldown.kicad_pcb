(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "+5V")
  (net 3 "GATE_CTRL")
  (net 4 "LOAD_DRAIN")
  (module Package_QFP:TQFP-32_7x7mm_P0.8mm (layer F.Cu)
    (at 100 100)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
    (fp_text value ATmega328P (at 0 2) (layer F.Fab))
    (pad 7  smd rect (at -3 0) (net 2 "+5V"))
    (pad 8  smd rect (at -3 1) (net 1 "GND"))
    (pad 14 smd rect (at 3 0) (net 3 "GATE_CTRL"))
    (pad 20 smd rect (at 3 1) (net 2 "+5V"))
    (pad 22 smd rect (at 3 2) (net 1 "GND"))
  )
  (module Package_TO_SOT_SMD:SOT-23 (layer F.Cu)
    (at 110 100)
    (fp_text reference Q1 (at 0 0) (layer F.SilkS))
    (fp_text value 2N7002 (at 0 2) (layer F.Fab))
    (pad G smd rect (at 0 0) (net 3 "GATE_CTRL"))
    (pad D smd rect (at 1 0) (net 4 "LOAD_DRAIN"))
    (pad S smd rect (at 2 0) (net 1 "GND"))
  )
  (module Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm (layer F.Cu)
    (at 112 100)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 1k (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 0) (net 2 "+5V"))
    (pad 2 thru_hole circle (at 2 0) (net 4 "LOAD_DRAIN"))
  )
  (module Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm (layer F.Cu)
    (at 110 102)
    (fp_text reference R2 (at 0 0) (layer F.SilkS))
    (fp_text value 10k (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 0) (net 3 "GATE_CTRL"))
    (pad 2 thru_hole circle (at 2 0) (net 1 "GND"))
  )
)
