(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "VBUS")
  (net 3 "CC1")
  (net 4 "CC2")
  (module Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12 (layer F.Cu)
    (at 100 100)
    (fp_text reference J1 (at 0 0) (layer F.SilkS))
    (fp_text value USB_C_Receptacle (at 0 2) (layer F.Fab))
    (pad A5 smd rect (at 0 0) (net 3 "CC1"))
    (pad B5 smd rect (at 1 0) (net 4 "CC2"))
    (pad A4 smd rect (at 2 0) (net 2 "VBUS"))
    (pad A1 smd rect (at 3 0) (net 1 "GND"))
  )
  (module Resistor_SMD:R_0402_1005Metric (layer F.Cu)
    (at 105 100)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 5.1k (at 0 2) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (net 3 "CC1"))
    (pad 2 smd rect (at 1 0) (net 1 "GND"))
  )
  (module Resistor_SMD:R_0402_1005Metric (layer F.Cu)
    (at 105 105)
    (fp_text reference R2 (at 0 0) (layer F.SilkS))
    (fp_text value 5.1k (at 0 2) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (net 4 "CC2"))
    (pad 2 smd rect (at 1 0) (net 1 "GND"))
  )
  (module Package_TO_SOT_SMD:SOT-23 (layer F.Cu)
    (at 110 100)
    (fp_text reference Q1 (at 0 0) (layer F.SilkS))
    (fp_text value XFET9999 (at 0 2) (layer F.Fab))
    (pad G smd rect (at 0 0) (net 3 "CC1"))
    (pad D smd rect (at 1 0) (net 2 "VBUS"))
    (pad S smd rect (at 2 0) (net 1 "GND"))
  )
)
