(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "SENSOR_OUT")
  (module Package_SO:SOIC-8_3.9x4.9mm_P1.27mm (layer F.Cu)
    (at 110 100)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
    (fp_text value XLOGIC9999 (at 0 2) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (net 2 "+3V3"))
    (pad 4 smd rect (at 1 0) (net 1 "GND"))
    (pad 5 smd rect (at 2 0) (net 3 "SENSOR_OUT"))
  )
  (module Resistor_SMD:R_0603_1608Metric (layer F.Cu)
    (at 130 100)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 10k (at 0 2) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (net 2 "+3V3"))
    (pad 2 smd rect (at 2 0) (net 3 "SENSOR_OUT"))
  )
  (module Resistor_SMD:R_0603_1608Metric (layer F.Cu)
    (at 130 110)
    (fp_text reference R2 (at 0 0) (layer F.SilkS))
    (fp_text value 1k (at 0 2) (layer F.Fab))
    (pad 1 smd rect (at 0 0) (net 3 "SENSOR_OUT"))
    (pad 2 smd rect (at 2 0) (net 1 "GND"))
  )
)
