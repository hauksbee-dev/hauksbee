# Board-as-Code (hauksbee board DSL v1)
# A +5V rail with a 330R load, a 10k pull-up and one unmodelled part, J1: a
# header whose value is a numeric part number, on the rail and a signal net.
# `hauksbee check` treats an open connector as a stated condition, not as a
# reason to refuse the verdict; renamed to U1 the same open part is an active
# IC, which does refuse it. hauksbee-ci must judge it by the same rule.
board version 20171130

fn main {
    net "+5V"
    net "SIG"
    net "GND"
    comp R1 lib "Resistor_SMD:R_0805_2012Metric" val "330" layer "F.Cu" at 20 20 rot 0 {
        pad "1" smd rect at -0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "+5V"
        pad "2" smd rect at 0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp R2 lib "Resistor_SMD:R_0805_2012Metric" val "10k" layer "F.Cu" at 30 20 rot 0 {
        pad "1" smd rect at -0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "+5V"
        pad "2" smd rect at 0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "SIG"
    }
    comp J1 lib "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" val "62701021621" layer "F.Cu" at 40 20 rot 0 {
        pad "1" thru_hole rect at 0 0 size 1.7 1.7 layers [*.Cu *.Mask] net "+5V"
        pad "2" thru_hole rect at 0 2.54 size 1.7 1.7 layers [*.Cu *.Mask] net "SIG"
        pad "3" thru_hole rect at 0 5.08 size 1.7 1.7 layers [*.Cu *.Mask] net "GND"
    }
}
