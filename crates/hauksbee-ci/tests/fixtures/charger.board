# Board-as-Code (hauksbee board DSL v1)
# A TP4056 linear charger from VIN to a cell net VBAT: PROG to ground through
# 5k (about 0.24 A), CE tied to the input, a 10uF cap on the cell net.
board version 20171130

fn main {
    net "VIN"
    net "VBAT"
    net "PROG"
    net "GND"
    comp U1 lib "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" val "TP4056" layer "F.Cu" at 20 20 rot 0 {
        pad "2" smd rect at -2.7 -0.635 size 1.5 0.6 layers [F.Cu F.Paste F.Mask] net "PROG"
        pad "3" smd rect at -2.7 0.635 size 1.5 0.6 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "4" smd rect at -2.7 1.905 size 1.5 0.6 layers [F.Cu F.Paste F.Mask] net "VIN"
        pad "5" smd rect at 2.7 1.905 size 1.5 0.6 layers [F.Cu F.Paste F.Mask] net "VBAT"
        pad "8" smd rect at 2.7 -1.905 size 1.5 0.6 layers [F.Cu F.Paste F.Mask] net "VIN"
    }
    comp R1 lib "Resistor_SMD:R_0402_1005Metric" val "5k" layer "F.Cu" at 30 20 rot 0 {
        pad "1" smd rect at -0.51 0 size 0.54 0.64 layers [F.Cu F.Paste F.Mask] net "PROG"
        pad "2" smd rect at 0.51 0 size 0.54 0.64 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp C1 lib "Capacitor_SMD:C_1206_3216Metric" val "10uF" layer "F.Cu" at 40 20 rot 0 {
        pad "1" smd roundrect at -1.4 0 size 1.25 1.75 layers [F.Cu F.Paste F.Mask] net "VBAT"
        pad "2" smd roundrect at 1.4 0 size 1.25 1.75 layers [F.Cu F.Paste F.Mask] net "GND"
    }
}
