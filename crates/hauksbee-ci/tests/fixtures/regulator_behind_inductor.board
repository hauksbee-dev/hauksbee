# Board-as-Code (hauksbee board DSL v1)
# A 5 V LDO (U1) whose output reaches the +5V rail through a series inductor
# (L1), and a 3.3 V LDO (U2) fed from that rail. Nothing powers VIN, so a bare
# run asks for a supply; the place the run accepts one is VIN, because U1
# already drives +5V through L1 and a supply there would fight it.
board version 20171130

fn main {
    net "VIN"
    net "SW"
    net "+5V"
    net "+3V3"
    net "GND"
    comp U1 lib "Package_TO_SOT_SMD:SOT-223-3_TabPin2" val "AMS1117-5.0" layer "F.Cu" at 20 20 rot 0 {
        pad "1" smd rect at -3.15 -2.3 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "2" smd rect at -3.15 0 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "SW"
        pad "3" smd rect at -3.15 2.3 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "VIN"
    }
    comp C1 lib "Capacitor_SMD:C_0805_2012Metric" val "10uF" layer "F.Cu" at 20 30 rot 0 {
        pad "1" smd roundrect at -0.95 0 size 1 1.45 layers [F.Cu F.Paste F.Mask] net "VIN"
        pad "2" smd roundrect at 0.95 0 size 1 1.45 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp C2 lib "Capacitor_SMD:CP_Elec_6.3x5.4" val "22uF" layer "F.Cu" at 30 30 rot 0 {
        pad "1" smd roundrect at -2.8 0 size 3.5 1.6 layers [F.Cu F.Paste F.Mask] net "SW"
        pad "2" smd roundrect at 2.8 0 size 3.5 1.6 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp L1 lib "Inductor_SMD:L_0805_2012Metric" val "10uH" layer "F.Cu" at 30 20 rot 0 {
        pad "1" smd roundrect at -1 0 size 1 1.45 layers [F.Cu F.Paste F.Mask] net "SW"
        pad "2" smd roundrect at 1 0 size 1 1.45 layers [F.Cu F.Paste F.Mask] net "+5V"
    }
    comp U2 lib "Package_TO_SOT_SMD:SOT-223-3_TabPin2" val "AMS1117-3.3" layer "F.Cu" at 40 20 rot 0 {
        pad "1" smd rect at -3.15 -2.3 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "2" smd rect at -3.15 0 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "+3V3"
        pad "3" smd rect at -3.15 2.3 size 2 1.5 layers [F.Cu F.Paste F.Mask] net "+5V"
    }
    comp C3 lib "Capacitor_SMD:CP_Elec_6.3x5.4" val "22uF" layer "F.Cu" at 50 30 rot 0 {
        pad "1" smd roundrect at -2.8 0 size 3.5 1.6 layers [F.Cu F.Paste F.Mask] net "+3V3"
        pad "2" smd roundrect at 2.8 0 size 3.5 1.6 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp R1 lib "Resistor_SMD:R_0805_2012Metric" val "330" layer "F.Cu" at 50 20 rot 0 {
        pad "1" smd rect at -0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "+3V3"
        pad "2" smd rect at 0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "GND"
    }
}
