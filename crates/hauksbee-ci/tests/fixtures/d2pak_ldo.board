# Board-as-Code (hauksbee board DSL v1)
# A fixed 3.3 V LDO in D2PAK (TO-263-3, the tab numbered 2 with the centre
# lead) from VIN to VOUT, its 10uF minimum output cap and a 33R (100 mA) load.
# Its pads carry bare numbers, so the card's assumed numbering is all that
# names them, reported per pad (d2pak_ldo_named.kicad_pcb is the same board
# with pin names).
board version 20171130

fn main {
    net "VIN"
    net "VOUT"
    net "GND"
    comp U1 lib "Package_TO_SOT_SMD:TO-263-3_TabPin2" val "LD1086D2T33TR" layer "F.Cu" at 20 20 rot 0 {
        pad "1" smd roundrect at -6.65 -2.54 size 4.6 1.1 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "2" smd roundrect at -6.65 0 size 4.6 1.1 layers [F.Cu F.Paste F.Mask] net "VOUT"
        pad "2" smd roundrect at 3.2 0 size 9.4 10.8 layers [F.Cu F.Mask] net "VOUT"
        pad "3" smd roundrect at -6.65 2.54 size 4.6 1.1 layers [F.Cu F.Paste F.Mask] net "VIN"
    }
    comp C1 lib "Capacitor_SMD:C_1206_3216Metric" val "10uF" layer "F.Cu" at 30 20 rot 0 {
        pad "1" smd roundrect at -1.4 0 size 1.25 1.75 layers [F.Cu F.Paste F.Mask] net "VOUT"
        pad "2" smd roundrect at 1.4 0 size 1.25 1.75 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp R1 lib "Resistor_SMD:R_0805_2012Metric" val "33" layer "F.Cu" at 40 20 rot 0 {
        pad "1" smd rect at -0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "VOUT"
        pad "2" smd rect at 0.9125 0 size 1.025 1.4 layers [F.Cu F.Paste F.Mask] net "GND"
    }
}
