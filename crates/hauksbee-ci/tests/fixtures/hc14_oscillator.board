board version 1

fn main {
    net "VCC"
    net "GND"
    net "OSC_IN"
    net "OSC_OUT"

    comp J1 lib "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" val "PWR" layer "F.Cu" at 5 5 rot 0 {
        pad "1" thru_hole circle at 0 0 size 1.7 1.7 drill 1.0 layers [F.Cu B.Cu] net "VCC"
        pad "2" thru_hole circle at 0 2.54 size 1.7 1.7 drill 1.0 layers [F.Cu B.Cu] net "GND"
    }
    comp R1 lib "Resistor_SMD:R_0805_2012Metric" val "10k" layer "F.Cu" at 15 5 rot 0 {
        pad "1" smd roundrect at -0.9375 0 size 0.975 1.4 layers [F.Cu F.Paste F.Mask] net "OSC_OUT"
        pad "2" smd roundrect at 0.9375 0 size 0.975 1.4 layers [F.Cu F.Paste F.Mask] net "OSC_IN"
    }
    comp C1 lib "Capacitor_SMD:C_0805_2012Metric" val "10nF" layer "F.Cu" at 25 5 rot 0 {
        pad "1" smd roundrect at -0.9375 0 size 0.975 1.4 layers [F.Cu F.Paste F.Mask] net "OSC_IN"
        pad "2" smd roundrect at 0.9375 0 size 0.975 1.4 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp U1 lib "Package_DIP:DIP-14_W7.62mm" val "74HC14" layer "F.Cu" at 45 5 rot 0 {
        pad "1"  thru_hole circle at 0    0    size 1.6 1.6 drill 0.8 layers [F.Cu B.Cu] net "OSC_IN"
        pad "2"  thru_hole circle at 0    2.54 size 1.6 1.6 drill 0.8 layers [F.Cu B.Cu] net "OSC_OUT"
        pad "7"  thru_hole circle at 0   15.24 size 1.6 1.6 drill 0.8 layers [F.Cu B.Cu] net "GND"
        pad "14" thru_hole circle at 7.62 0    size 1.6 1.6 drill 0.8 layers [F.Cu B.Cu] net "VCC"
    }
}
