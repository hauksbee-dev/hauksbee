# Three unmodelled parts on one +12V auto rail (open_driver_validity.rs):
#  U1 buck: drives VOUT through L1. MID (RA/RB) and FLOAT (C2 only) are unrelated.
#  U3 LM337: a pin on VADJ (an adjustable NEGATIVE part, still unmodelled), which RC/R1/R2 alone would put at a plausible 5.0 V.
#  U2: hangs on RAIL and is powered only FROM it, so it can load but never drive.
#  J1: a header whose value is a numeric part number; a port on MID, never a driver.
board version 20171130

fn main {
    net "GND"
    net "+12V"
    net "SW"
    net "VOUT"
    net "MID"
    net "FLOAT"
    net "ADJ"
    net "VADJ"
    net "RAIL"
    net "SIG"
    comp U1 lib "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" val "TPS54331D" layer "F.Cu" at 20 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "+12V"
        pad "3" smd rect at 2 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "SW"
    }
    comp L1 lib "Inductor_SMD:L_0805_2012Metric" val "6.8uH" layer "F.Cu" at 28 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "SW"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "VOUT"
    }
    comp RL lib "Resistor_SMD:R_0805_2012Metric" val "10" layer "F.Cu" at 36 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "VOUT"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp RA lib "Resistor_SMD:R_0805_2012Metric" val "10k" layer "F.Cu" at 44 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "+12V"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "MID"
    }
    comp RB lib "Resistor_SMD:R_0805_2012Metric" val "10k" layer "F.Cu" at 52 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "MID"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp C2 lib "Capacitor_SMD:C_0805_2012Metric" val "100nF" layer "F.Cu" at 60 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "FLOAT"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp U3 lib "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" val "LM337" layer "F.Cu" at 68 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "ADJ"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "VADJ"
        pad "3" smd rect at 2 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "+12V"
    }
    comp RC lib "Resistor_SMD:R_0805_2012Metric" val "1.4k" layer "F.Cu" at 76 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "+12V"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "VADJ"
    }
    comp R1 lib "Resistor_SMD:R_0805_2012Metric" val "240" layer "F.Cu" at 84 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "VADJ"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "ADJ"
    }
    comp R2 lib "Resistor_SMD:R_0805_2012Metric" val "760" layer "F.Cu" at 92 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "ADJ"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp R3 lib "Resistor_SMD:R_0805_2012Metric" val "10" layer "F.Cu" at 100 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "+12V"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "RAIL"
    }
    comp RD lib "Resistor_SMD:R_0805_2012Metric" val "10k" layer "F.Cu" at 108 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "RAIL"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
    }
    comp J1 lib "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" val "62701021621" layer "F.Cu" at 124 20 rot 0 {
        pad "1" thru_hole rect at 0 0 size 1.7 1.7 layers [*.Cu *.Mask] net "+12V"
        pad "2" thru_hole rect at 0 2.54 size 1.7 1.7 layers [*.Cu *.Mask] net "MID"
        pad "3" thru_hole rect at 0 5.08 size 1.7 1.7 layers [*.Cu *.Mask] net "GND"
    }
    comp U2 lib "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" val "TOTALLYUNKNOWN999" layer "F.Cu" at 116 20 rot 0 {
        pad "1" smd rect at 0 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "RAIL"
        pad "2" smd rect at 1 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "GND"
        pad "3" smd rect at 2 0 size 0.8 0.8 layers [F.Cu F.Paste F.Mask] net "SIG"
    }
}
