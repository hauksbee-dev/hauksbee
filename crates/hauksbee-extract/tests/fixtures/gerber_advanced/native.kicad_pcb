(kicad_pcb (version 20240108) (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (2 "In1.Cu" power)
    (4 "In2.Cu" power)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "SLOT")
  (net 2 "CASTELLATION")
  (net 3 "BLIND")
  (net 4 "BURIED")
  (footprint "AdvancedGeometry" (layer "F.Cu") (at 0 0)
    (property "Reference" "J1" (at 0 -2 0) (layer "F.SilkS"))
    (property "Value" "ADVANCED" (at 0 2 0) (layer "F.Fab"))
    (pad "1" thru_hole oval (at 4 8 90) (size 3 1.5) (drill oval 2 0.8) (layers "*.Cu" "*.Mask") (net 1 "SLOT"))
    (pad "2" thru_hole circle (at 0 5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "CASTELLATION"))
  )
  (via blind (at 3 3) (size 1) (drill 0.4) (layers "F.Cu" "In1.Cu") (net 3))
  (via blind (at 7 3) (size 1) (drill 0.4) (layers "In1.Cu" "In2.Cu") (net 4))
  (segment (start 3 3) (end 3 6) (width 0.5) (layer "F.Cu") (net 3))
  (segment (start 3 3) (end 5 3) (width 0.5) (layer "In1.Cu") (net 3))
  (segment (start 7 3) (end 7 6) (width 0.5) (layer "In1.Cu") (net 4))
  (segment (start 7 3) (end 9 3) (width 0.5) (layer "In2.Cu") (net 4))
  (gr_rect (start 0 0) (end 10 10) (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))
)
