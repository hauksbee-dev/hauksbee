<?xml version="1.0"?>
<eagle version="6.6.0"><drawing><layers>
<layer number="1" name="Top"/><layer number="16" name="Bottom"/>
</layers><board><libraries><library name="device"><packages><package name="R0603">
<smd name="1" x="-0.8" y="0" dx="0.8" dy="0.8" layer="1"/><smd name="2" x="0.8" y="0" dx="0.8" dy="0.8" layer="1"/>
</package></packages></library></libraries><designrules name="default">
<param name="mdWireWire" value="6mil"/><param name="mdWirePad" value="6mil"/>
<param name="mdPadPad" value="6mil"/><param name="mdSmdSmd" value="6mil"/>
</designrules><elements><element name="R1" library="device" package="R0603" value="10k" x="20" y="20"/></elements><signals>
<signal name="GND"><contactref element="R1" pad="1"/><via x="5" y="0" extent="1-16" drill="0.3" diameter="0.8"/></signal>
<signal name="AGND"><contactref element="R1" pad="2"/><wire x1="5" y1="-5" x2="5" y2="5" width="0.5" layer="1"/><wire x1="5" y1="-5" x2="5" y2="5" width="0.5" layer="16"/></signal>
</signals></board></drawing></eagle>
