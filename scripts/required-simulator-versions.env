# Versions whose real execution may count as release-required integration evidence.
# This file is sourced by install-sims.sh and hashed into the simulator cache key.
RENODE_VERSION="1.16.1"
QEMU_VERSION="esp-develop-9.2.2-20260417"
QEMU_COMMIT="40edccac415693c5130f91c01d84176ae6008566"

# Espressif's esp-develop-9.2.2-20260417 darwin x86_64 tarballs are mislabeled
# upstream: the xtensa and riscv32 "x86_64-apple-darwin" archives both contain
# arm64 binaries (verified with file(1); a real Intel Mac refuses them with
# "Bad CPU type in executable"). Until Espressif republishes, Intel macOS pins
# the previous release of the same QEMU 9.2.2 fork, whose Intel binaries are
# genuinely x86_64. install-sims.sh applies this override after platform
# detection; every other platform keeps QEMU_VERSION above.
QEMU_VERSION_DARWIN_X86_64="esp-develop-9.2.2-20250817"
QEMU_COMMIT_DARWIN_X86_64="4f4148e2f68689eb8861bf9fce0b46ada9200fef"
