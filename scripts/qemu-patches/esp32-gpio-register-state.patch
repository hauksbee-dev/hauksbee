+/*
+ * The classic ESP32's IO_MUX (0x3FF49000) and RTC IO (0x3FF48400) blocks as
+ * plain register files: writes are retained and read back from the
+ * documented reset values, so a host can see which pads an IO_MUX direct
+ * function, the RTC mux, a DAC or a touch channel owns.  Nothing behind the
+ * registers (pad drive, DAC, touch, pulls) is emulated.  "rtc-io" selects
+ * the RTC IO layout (W1TS/W1TC words, read-only RTC_GPIO_IN).
+ */
+#define TYPE_ESP32_PAD_REGS "esp32.padregs"
+#define ESP32_PAD_REGS(obj) OBJECT_CHECK(Esp32PadRegsState, (obj), TYPE_ESP32_PAD_REGS)
+#define ESP32_PAD_REGS_MAX 51
+
+typedef struct Esp32PadRegsState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    bool rtc_io;
+    uint32_t regs[ESP32_PAD_REGS_MAX];
+} Esp32PadRegsState;
