+static void esp32_gpio_reset_func_out_sel(Esp32GpioState *s)
+{
+    int i;
+
+    for (i = 0; i < ESP32_GPIO_FUNC_OUT_SEL_COUNT; i++) {
+        s->func_out_sel[i] = ESP32_GPIO_FUNC_OUT_SEL_GPIO;
+    }
+}
+
+static bool esp32_gpio_is_func_out_sel(hwaddr addr, unsigned int size)
+{
+    return size == 4 && (addr & 3) == 0 &&
+           addr >= ESP32_GPIO_FUNC_OUT_SEL_OFFSET &&
+           addr < ESP32_GPIO_FUNC_OUT_SEL_OFFSET +
+                  4 * ESP32_GPIO_FUNC_OUT_SEL_COUNT;
+}
