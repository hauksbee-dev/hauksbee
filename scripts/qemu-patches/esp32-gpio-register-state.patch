+        break;
+    case A_GPIO_OUT1:
+        r = s->gpio_out[1];
+        break;
+    case A_GPIO_ENABLE:
+        r = s->gpio_enable[0];
+        break;
+    case A_GPIO_ENABLE1:
+        r = s->gpio_enable[1];
+        break;
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
 
     default:
+        if (esp32_gpio_is_func_out_sel(addr, size)) {
+            r = s->func_out_sel[(addr - ESP32_GPIO_FUNC_OUT_SEL_OFFSET) / 4];
+        }
         break;
     }
     return r;
