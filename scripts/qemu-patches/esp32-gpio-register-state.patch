diff --git a/hw/gpio/esp32_gpio.c b/hw/gpio/esp32_gpio.c
--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -21,16 +21,48 @@
 
 
 
+static void esp32_gpio_reset_func_out_sel(Esp32GpioState *s)
+{
+    int i;
+
+    for (i = 0; i < ESP32_GPIO_FUNC_OUT_SEL_COUNT; i++) {
+        s->func_out_sel[i] = ESP32_GPIO_FUNC_OUT_SEL_GPIO;
+    }
+}
+
+static bool esp32_gpio_is_func_out_sel(hwaddr addr, unsigned int size)
+{
+    return size == 4 && (addr & 3) == 0 &&
+           addr >= ESP32_GPIO_FUNC_OUT_SEL_OFFSET &&
+           addr < ESP32_GPIO_FUNC_OUT_SEL_OFFSET +
+                  4 * ESP32_GPIO_FUNC_OUT_SEL_COUNT;
+}
+
 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
     uint64_t r = 0;
     switch (addr) {
+    case A_GPIO_OUT:
+        r = s->gpio_out[0];
+        break;
+    case A_GPIO_OUT1:
+        r = s->gpio_out[1];
+        break;
+    case A_GPIO_ENABLE:
+        r = s->gpio_enable[0];
+        break;
+    case A_GPIO_ENABLE1:
+        r = s->gpio_enable[1];
+        break;
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
 
     default:
+        if (esp32_gpio_is_func_out_sel(addr, size)) {
+            r = s->func_out_sel[(addr - ESP32_GPIO_FUNC_OUT_SEL_OFFSET) / 4];
+        }
         break;
     }
     return r;
@@ -39,6 +71,53 @@
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t v = value;
+
+    switch (addr) {
+    case A_GPIO_OUT:
+        s->gpio_out[0] = v;
+        break;
+    case A_GPIO_OUT_W1TS:
+        s->gpio_out[0] |= v;
+        break;
+    case A_GPIO_OUT_W1TC:
+        s->gpio_out[0] &= ~v;
+        break;
+    case A_GPIO_OUT1:
+        s->gpio_out[1] = v;
+        break;
+    case A_GPIO_OUT1_W1TS:
+        s->gpio_out[1] |= v;
+        break;
+    case A_GPIO_OUT1_W1TC:
+        s->gpio_out[1] &= ~v;
+        break;
+    case A_GPIO_ENABLE:
+        s->gpio_enable[0] = v;
+        break;
+    case A_GPIO_ENABLE_W1TS:
+        s->gpio_enable[0] |= v;
+        break;
+    case A_GPIO_ENABLE_W1TC:
+        s->gpio_enable[0] &= ~v;
+        break;
+    case A_GPIO_ENABLE1:
+        s->gpio_enable[1] = v;
+        break;
+    case A_GPIO_ENABLE1_W1TS:
+        s->gpio_enable[1] |= v;
+        break;
+    case A_GPIO_ENABLE1_W1TC:
+        s->gpio_enable[1] &= ~v;
+        break;
+    default:
+        if (esp32_gpio_is_func_out_sel(addr, size)) {
+            s->func_out_sel[(addr - ESP32_GPIO_FUNC_OUT_SEL_OFFSET) / 4] =
+                v & ESP32_GPIO_FUNC_OUT_SEL_MASK;
+        }
+        break;
+    }
 }
 
