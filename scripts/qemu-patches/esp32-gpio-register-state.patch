--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -26,6 +26,18 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
     Esp32GpioState *s = ESP32_GPIO(opaque);
     uint64_t r = 0;
     switch (addr) {
+    case A_GPIO_OUT:
+        r = s->gpio_out[0];
+        break;
+    case A_GPIO_OUT1:
+        r = s->gpio_out[1];
+        break;
+    case A_GPIO_ENABLE:
+        r = s->gpio_enable[0];
+        break;
+    case A_GPIO_ENABLE1:
+        r = s->gpio_enable[1];
+        break;
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
@@ -39,6 +51,49 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t v = value;
+
+    switch (addr) {
+    case A_GPIO_OUT:
+        s->gpio_out[0] = v;
+        break;
+    case A_GPIO_OUT_W1TS:
+        s->gpio_out[0] |= v;
+        break;
+    case A_GPIO_OUT_W1TC:
+        s->gpio_out[0] &= ~v;
+        break;
+    case A_GPIO_OUT1:
+        s->gpio_out[1] = v;
+        break;
+    case A_GPIO_OUT1_W1TS:
+        s->gpio_out[1] |= v;
+        break;
+    case A_GPIO_OUT1_W1TC:
+        s->gpio_out[1] &= ~v;
+        break;
+    case A_GPIO_ENABLE:
+        s->gpio_enable[0] = v;
+        break;
+    case A_GPIO_ENABLE_W1TS:
+        s->gpio_enable[0] |= v;
+        break;
+    case A_GPIO_ENABLE_W1TC:
+        s->gpio_enable[0] &= ~v;
+        break;
+    case A_GPIO_ENABLE1:
+        s->gpio_enable[1] = v;
+        break;
+    case A_GPIO_ENABLE1_W1TS:
+        s->gpio_enable[1] |= v;
+        break;
+    case A_GPIO_ENABLE1_W1TC:
+        s->gpio_enable[1] &= ~v;
+        break;
+    default:
+        break;
+    }
 }
 
