@@ -9,8 +9,45 @@
 #define ESP32_GPIO_GET_CLASS(obj)   OBJECT_GET_CLASS(Esp32GpioClass, obj, TYPE_ESP32_GPIO)
 #define ESP32_GPIO_CLASS(klass)     OBJECT_CLASS_CHECK(Esp32GpioClass, klass, TYPE_ESP32_GPIO)
 
-REG32(GPIO_STRAP, 0x0038)
+/*
+ * The classic ESP32, ESP32-S3 and ESP32-C3 use the same low-bank GPIO
+ * register offsets.  The classic/S3 parts also expose a high bank for GPIOs
+ * 32 and above.  Keep these names local to the device model so firmware MMIO
+ * writes have one source of truth and host reads observe the same state.
+ */
+REG32(GPIO_OUT,          0x0004)
+REG32(GPIO_OUT_W1TS,     0x0008)
+REG32(GPIO_OUT_W1TC,     0x000c)
+REG32(GPIO_OUT1,         0x0010)
+REG32(GPIO_OUT1_W1TS,    0x0014)
+REG32(GPIO_OUT1_W1TC,    0x0018)
+REG32(GPIO_ENABLE,       0x0020)
+REG32(GPIO_ENABLE_W1TS,  0x0024)
+REG32(GPIO_ENABLE_W1TC,  0x0028)
+REG32(GPIO_ENABLE1,      0x002c)
+REG32(GPIO_ENABLE1_W1TS, 0x0030)
+REG32(GPIO_ENABLE1_W1TC, 0x0034)
+REG32(GPIO_STRAP,        0x0038)
 
+/*
+ * GPIO_FUNCn_OUT_SEL_CFG_REG: one word per pad, pad n at 0x0530 + 4 * n
+ * (ESP32 TRM v5.8, "Register 6.32. GPIO_FUNCn_OUT_SEL_CFG_REG"; ESP-IDF
+ * components/soc/esp32/register/soc/gpio_reg.h, GPIO_FUNC0_OUT_SEL_CFG_REG =
+ * DR_REG_GPIO_BASE + 0x0530 .. GPIO_FUNC39_OUT_SEL_CFG_REG = + 0x05cc).
+ * Bits [8:0] OUT_SEL: peripheral output signal routed to the pad, or 256
+ * (0x100) for the plain GPIO_OUT/GPIO_ENABLE bit; bit 9 OUT_INV_SEL; bit 10
+ * OEN_SEL (1: output enable from GPIO_ENABLE, 0: from the peripheral); bit 11
+ * OEN_INV_SEL.  The classic ESP32 layout only: the ESP32-S3 and ESP32-C3
+ * blocks start at 0x0554, so a host must read these words only for the
+ * classic part.
+ */
+#define ESP32_GPIO_FUNC_OUT_SEL_OFFSET 0x0530
+#define ESP32_GPIO_FUNC_OUT_SEL_COUNT  40
+#define ESP32_GPIO_FUNC_OUT_SEL_MASK   0x00000fff
+/* The TRM gives the reset value as undefined (x); the model resets to the
+ * "plain GPIO" selection so an untouched pad reads as not peripheral-routed. */
+#define ESP32_GPIO_FUNC_OUT_SEL_GPIO   0x100
+
 #define ESP32_STRAP_MODE_FLASH_BOOT 0x12
 #define ESP32_STRAP_MODE_UART_BOOT  0x0f
 
