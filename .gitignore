target/
node_modules/
dist/

# Intermediate firmware artifacts (the .elf is committed for testing on hosts
# without arm-none-eabi-gcc; the raw .bin is regenerable and not needed).
testdata/firmware/stm32_blinky/blinky.bin

# The RP2040 reference manual is 5.3 MB - too large to commit. The resource-extract
# live test downloads it on demand (see docs/checks/RESOURCE_CONFLICTS.md); the small
# machine-extracted result it produces is committed at
# testdata/resource/rp2040_pwm_extracted.toml as the offline fixture.
testdata/datasheets/rp2040-datasheet.pdf

# Python bytecode caches
__pycache__/
*.pyc

# Claude Code session data / agent worktrees
.claude/
.playwright-cli/
scratchpad/

# Firmware build scratch (regenerated by each board's build.sh; only the merged
# flash.bin and app .elf are committed, per testdata/firmware/*/.gitignore).
testdata/firmware/*/build/
testdata/firmware/*/build_c3/

# Tarski investigation recurring experiment output (tracked artifacts stay tracked)
tarski-works/**/*.log
tarski-works/oracle_slice_*/

# macOS noise
.DS_Store
codex-webreview.log
