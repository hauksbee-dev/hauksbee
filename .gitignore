target/
node_modules/
dist/

# Intermediate firmware artifacts (the .elf is committed for testing on hosts
# without arm-none-eabi-gcc; the raw .bin is regenerable and not needed).
testdata/firmware/stm32_blinky/blinky.bin

# The RP2040 reference manual is 5.3 MB - too large to commit. The resource-extract
# live test downloads it on demand (see docs/checks/RESOURCE_CONFLICTS.md); the small
# machine-extracted result it produces is committed at
# testdata/resource/rp2040_pwm_extracted.toml as the offline fixture.
testdata/datasheets/rp2040-datasheet.pdf

# Python bytecode caches
__pycache__/
*.pyc

# freerouting writes logs/freerouting.log into the checkout it runs from.
logs/

# Claude Code session data / agent worktrees
.claude/
.playwright-cli/
scratchpad/

# Firmware build scratch (regenerated by each board's build.sh; only the merged
# flash.bin and app .elf are committed, per testdata/firmware/*/.gitignore).
testdata/firmware/*/build/
testdata/firmware/*/build_c3/

# Tarski investigation recurring experiment output (tracked artifacts stay tracked)
tarski-works/**/*.log
tarski-works/oracle_slice_*/

# Launch-video intermediates: raw playwright webms, and the remotion media
# dir (copies of video/renders, staged by video/remotion/sync-media.sh).
frontend/capture/out/launch/
video/remotion/public/media/

# macOS noise
.DS_Store
codex-webreview.log
vendor/kicad-forge/Cargo.lock
codex-routing-mosfet-review.log

# Agent verification screenshots (scratch, never repo content)
uifix/

# Visual-lint output: the screenshots of violating states, written fresh on
# every run (frontend/tests/visual-lint).
frontend/test-results/

# The board corpus is fetched, never vendored. Every board comes from its own
# author under CC BY-SA, GPL-3.0 or CERN-OHL, and obtaining each one directly
# from that author under that author's terms is the whole reason this
# repository does not carry them. CONTRIBUTING tells people to run
# scripts/fetch-corpus.sh, so without this line a `git add -A` after following
# our own instructions commits a few hundred MB of third-party hardware into a
# repo that has no right to redistribute it.
board-corpus/

# Boards that a fetch dropped at the repository root rather than under
# board-corpus/. Ignored so they cannot be committed by accident; delete them
# when you find them.
/crkbd/
/lily58/
/mppt_1210_hus/
/zswatch_devkit_1_2_0/

# The landing site is a separate repository (personal asset, not part of the project)
site/

# `hauksbee-ci run --junit` with a directory argument, and the JUnit fixtures the
# CI suites write beside the checkout. Regenerated by every run, reviewed never.
hauksbee-ci-junit/

# Scenario QC (qc/): the binaries it runs are copied out of target/ so a
# concurrent rebuild cannot swap them mid-suite, and every run writes a
# timestamped transcript directory. Both are regenerated, never reviewed.
qc/.bin-cache/
qc/results/

# The ingest-robustness corpus is several GB of third-party board files
# harvested from public repositories on demand; the harness that rebuilds it
# lives in testdata/ingest-robustness/corpus-harness/ and its manifest records
# repo + commit + path for every file, so the corpus itself is regenerable and
# is never committed.
testdata/ingest-robustness/corpus-harness/ingest-corpus/
testdata/ingest-robustness/corpus-harness/matrix-results.jsonl
