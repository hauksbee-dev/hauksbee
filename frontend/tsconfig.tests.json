{
  // The tests and the visual-lint harness, type-checked on the same settings as
  // src (strict, no unused). They ran untyped for a while, which meant a rename
  // in src/lib could leave a test importing a symbol that no longer exists and
  // nothing said so until `bun test` ran. `bun` types cover `bun:test`, `Bun.serve`
  // and `Bun.spawn`; DOM is here because the harness's audit function is
  // serialized into a browser and talks to the real DOM API.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["bun-types", "vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["tests", "mock-server.ts", "src/vite-env.d.ts"]
}
