# hauksbee slim/core image: the everyday CI image.
#
# Contains the prebuilt `hauksbee` + `hauksbee-ci` binaries (built here from
# source, default features so simavr is linked in), the reference model db, and
# the simavr runtime libraries. This is everything the static checks (DRC,
# netlint, SI, resource conflicts), board-as-code, and the built-in AVR
# co-simulation need. It deliberately does NOT carry Renode, the Espressif QEMU
# fork, or freerouting; reach for the `full` image when you need STM32 / ESP32
# co-sim or production autorouting. It also carries no kicad-cli (see the
# runtime stage for why that is neither possible on this base nor needed).
#
# BUILD CONTEXT: the forge-* crates are vendored into this repo
# (vendor/kicad-forge; see vendor/kicad-forge/VENDORED.md), so the build is
# self-contained and the context is a parent directory holding just this repo:
#
#   parent/
#     hauksbee/        (this repo, incl. vendor/kicad-forge)
#
# Build from that parent with:
#   docker build --build-arg SOURCE_COMMIT="$(git -C parent/hauksbee rev-parse HEAD)" \
#     -f parent/hauksbee/docker/Dockerfile.slim -t hauksbee:slim parent/
#
# Multi-arch (linux/amd64 + linux/arm64) is produced by buildx in CI; see
# .github/workflows/docker.yml. simavr is built natively per arch (no
# cross-compile), which is why the image builds simavr from a versioned source
# tag rather than trusting a distro package that may lag.

# Pinned base image versions. These MUST sit above the first FROM: an ARG
# declared inside a stage is scoped to that stage, so a later `FROM rust:${...}`
# expanded to the empty string and the build died with "failed to parse stage
# name". Declaring them here makes them global, and each stage that wants one in
# a RUN re-declares it below.
# Keep RUST_CHANNEL equal to the channel in rust-toolchain.toml. When they
# differ, rustup honours the toolchain file and downloads a whole second
# toolchain at build time, so the pin here buys nothing and costs a download on
# every build.
ARG RUST_CHANNEL=1.92.0
ARG DEBIAN_BASE=debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ARG RUST_BASE=rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
ARG SIMAVR_COMMIT=f44723e8c42431136d5b4de81f789ded56d7e8fa
ARG SIMAVR_TAG=v1.8

# ---------------------------------------------------------------------------
# Stage 1: build simavr (static lib) so the `avr` feature can link it.
# ---------------------------------------------------------------------------
FROM ${DEBIAN_BASE} AS simavr-build

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG SIMAVR_COMMIT
ARG SIMAVR_TAG

# build-essential + gcc, libelf-dev (libelf.pc, the only hard simavr dep), git
# (simavr derives its version from `git describe`, so the clone must carry tags).
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libelf-dev \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Build from the repo ROOT: `build-simavr` and `install-simavr` are top-level
# targets (they recurse into simavr/). PREFIX and DESTDIR are the same knob in
# simavr's Makefile, so set them equal to land lib + headers under /usr/local.
# RELEASE=1 sets the runtime rpath to ${PREFIX}/lib. Use gcc (clang is not
# installed here). The install produces libsimavr.a (what the Rust build links),
# the headers in /usr/local/include/simavr, and simavr.pc.
WORKDIR /src
RUN git clone https://github.com/buserror/simavr.git \
    && git -C simavr checkout --detach "${SIMAVR_COMMIT}" \
    && test "$(git -C simavr rev-parse HEAD)" = "${SIMAVR_COMMIT}" \
    && test "$(git -C simavr rev-parse "${SIMAVR_TAG}^{commit}")" = "${SIMAVR_COMMIT}" \
    && make -C simavr CC=gcc RELEASE=1 build-simavr \
    && make -C simavr CC=gcc RELEASE=1 DESTDIR=/usr/local PREFIX=/usr/local install-simavr \
    && printf '%s\n' "${SIMAVR_COMMIT}" > /usr/local/.hauksbee-simavr-commit \
    && { find /usr/local/include/simavr -type f -name '*.h' -print \
           | LC_ALL=C sort \
           | while IFS= read -r header; do \
               sha256sum "$header" | sed 's#  /usr/local/#  #'; \
             done; \
         sha256sum /usr/local/lib/libsimavr.a | sed 's#  /usr/local/#  #'; \
       } > /usr/local/.hauksbee-simavr-payload.sha256 \
    && ldconfig
RUN tar --exclude=.git -czf /simavr-source.tar.gz -C /src simavr

# ---------------------------------------------------------------------------
# Stage 2: build the hauksbee binaries against that simavr.
# ---------------------------------------------------------------------------
FROM ${RUST_BASE} AS rust-build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG SIMAVR_COMMIT
ARG SOURCE_COMMIT
RUN printf '%s\n' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{40}$' \
    || { echo "SOURCE_COMMIT must be the exact 40-hex Hauksbee source revision" >&2; exit 1; }

# clang/libclang are needed by bindgen (the simavr build.rs generates bindings);
# libelf + zlib are simavr's link dependencies; pkg-config resolves both.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        libclang-dev \
        libelf-dev \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Bring the simavr static lib + headers in so the build.rs link step resolves.
COPY --from=simavr-build /usr/local/lib /usr/local/lib
COPY --from=simavr-build /usr/local/include /usr/local/include
COPY --from=simavr-build /usr/local/.hauksbee-simavr-commit /usr/local/.hauksbee-simavr-commit
COPY --from=simavr-build /usr/local/.hauksbee-simavr-payload.sha256 /usr/local/.hauksbee-simavr-payload.sha256
RUN ldconfig

# The build.rs hardcodes the homebrew search path /opt/homebrew/lib for macOS;
# on Linux the lib lives in /usr/local/lib, so make that discoverable to the
# linker and to pkg-config without patching the build script.
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
    BINDGEN_EXTRA_CLANG_ARGS="-I/usr/local/include -I/usr/local/include/simavr" \
    SIMAVR_COMMIT=${SIMAVR_COMMIT} \
    HAUKSBEE_SOURCE_COMMIT=${SOURCE_COMMIT}

# Use the toolchain the base image already has, ignoring rust-toolchain.toml.
# That file lists rust-analyzer so contributors' editors follow the project pin,
# which is right for a laptop and wrong here: an image build would fetch a
# ~200 MB editor component it can never use, on every build, and fail the whole
# image if static.rust-lang.org is unreachable. RUST_CHANNEL and the digest-
# pinned Rust base above keep the version
# the same either way, so this changes what is downloaded, not what is compiled.
ARG RUST_CHANNEL
ENV RUSTUP_TOOLCHAIN=${RUST_CHANNEL}

WORKDIR /build
# The forge-* crates are vendored inside this repo (vendor/kicad-forge), so only
# this repo is copied; no sibling checkout is needed.
COPY hauksbee/ ./hauksbee/

WORKDIR /build/hauksbee
# GPL Corresponding Source includes every registry crate compiled into the
# linked binaries, not merely Cargo.lock pointers to an external service. Cargo
# verifies the registry checksums while materialising the exact locked graph;
# the actual release build then runs offline from that tree. The archive copied
# into the runtime is made only after this, so it is the same rebuildable input.
RUN mkdir -p .cargo third-party \
    && cargo vendor --locked --versioned-dirs third-party/cargo-vendor > .cargo/config.toml \
    && registry_packages="$(grep -c '^source = \"registry+' Cargo.lock)" \
    && vendored_packages="$(find third-party/cargo-vendor -mindepth 2 -maxdepth 2 -name .cargo-checksum.json | wc -l | tr -d ' ')" \
    && test "$vendored_packages" = "$registry_packages" \
    && cargo metadata --locked --offline --no-deps >/dev/null \
    && cargo build --release --locked --offline -p hauksbee-engine -p hauksbee-ci \
    && strip target/release/hauksbee target/release/hauksbee-ci
RUN tar --exclude=.git --exclude=target --exclude=frontend/node_modules \
    -czf /hauksbee-source.tar.gz -C /build hauksbee

# ---------------------------------------------------------------------------
# Stage 3: slim runtime.
# ---------------------------------------------------------------------------
FROM ${DEBIAN_BASE} AS runtime

# licenses is GPL-3.0-only, not Apache-2.0: this image ships the default
# (avr) shape, which statically links GPL-3.0 libsimavr, so the BINARIES in
# the image are GPL-3.0 combined works even though hauksbee's source stays
# Apache-2.0. The full terms travel in /usr/share/doc/hauksbee/.
LABEL org.opencontainers.image.title="hauksbee (slim)" \
      org.opencontainers.image.description="Universal PCB emulator: static checks, board-as-code, AVR co-sim. Prebuilt hauksbee + hauksbee-ci with simavr linked in." \
      org.opencontainers.image.source="https://github.com/hauksbee-dev/hauksbee" \
      org.opencontainers.image.licenses="GPL-3.0-only"

# Runtime libraries only:
#   libelf1 + zlib1g  the shared libs the statically-linked simavr still needs
#   ca-certificates   TLS for anything that fetches over HTTPS
#
# No kicad-cli. Debian bookworm carries KiCad 6, which predates the kicad-cli
# tool entirely, so `apt-get install kicad-cli` cannot succeed here and the
# image never built. It is not needed either: hauksbee reads .kicad_pcb natively
# through the vendored forge crates. kicad-cli is only the optional geometric
# DRC oracle that hauksbee cross-checks itself against when one is installed,
# and its absence is reported rather than assumed (see reports/drc.rs).
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libelf1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Non-root user; CI mounts the checkout read-write so keep a stable uid.
RUN useradd --create-home --uid 1000 hauksbee

# The binaries embed the model db; the on-disk copy under db/ supports the
# layered ~/.hauksbee/models override and is handy documentation.
COPY --from=rust-build /build/hauksbee/target/release/hauksbee    /usr/local/bin/hauksbee
COPY --from=rust-build /build/hauksbee/target/release/hauksbee-ci /usr/local/bin/hauksbee-ci
COPY --from=rust-build /build/hauksbee/crates/hauksbee-models/db  /opt/hauksbee/db
COPY --from=rust-build /build/hauksbee/crates/hauksbee-ci/examples/boards/boot_gate.kicad_pcb /opt/hauksbee/crates/hauksbee-ci/examples/boards/boot_gate.kicad_pcb
COPY --from=rust-build /build/hauksbee/testdata/firmware/boot_gate_a/boot_gate.hex /opt/hauksbee/testdata/firmware/boot_gate_a/boot_gate.hex
COPY --from=rust-build /build/hauksbee/crates/hauksbee-ci/examples/boot_gate_pass.toml /opt/hauksbee/crates/hauksbee-ci/examples/boot_gate_pass.toml

# Licence terms travel with the image, same as with the tarballs: hauksbee's
# Apache-2.0 source terms + attribution, the GPL-3.0 text (the binaries link
# libsimavr statically, so GPL-3.0 section 4 wants the text enclosed), and a
# note stating plainly which licence the binaries carry and why.
COPY --from=rust-build /build/hauksbee/LICENSE               /usr/share/doc/hauksbee/LICENSE
COPY --from=rust-build /build/hauksbee/NOTICE                /usr/share/doc/hauksbee/NOTICE
COPY --from=rust-build /build/hauksbee/licenses/gpl-3.0.txt  /usr/share/doc/hauksbee/LICENSE-GPL-3.0.txt
COPY --from=rust-build /build/hauksbee/licenses/evalexpr-MIT.txt /usr/share/doc/hauksbee/LICENSE-EVALEXPR-MIT.txt
COPY --from=rust-build /hauksbee-source.tar.gz /usr/share/doc/hauksbee/source/hauksbee-source.tar.gz
COPY --from=simavr-build /simavr-source.tar.gz /usr/share/doc/hauksbee/source/simavr-source.tar.gz
RUN printf '%s\n' \
      'hauksbee container image - licence of the binaries' \
      '===================================================' \
      '' \
      'THE BINARIES /usr/local/bin/hauksbee AND /usr/local/bin/hauksbee-ci ARE' \
      'LICENSED TO YOU UNDER GPL-3.0.' \
      '' \
      "hauksbee's own source code is Apache-2.0 (LICENSE and NOTICE, in this" \
      'directory). This image builds the default shape, whose avr co-simulation' \
      'backend STATICALLY LINKS libsimavr (GPL-3.0); statically linking GPL-3.0' \
      'code makes the executables combined works, so they are distributed under' \
      'GPL-3.0. Running the image imposes no obligations at all; GPL-3.0' \
      'constrains redistribution, not use.' \
      '' \
      'Full GPL-3.0 text: LICENSE-GPL-3.0.txt, in this directory.' \
      'evalexpr 11.3.1 MIT notice: LICENSE-EVALEXPR-MIT.txt, in this directory.' \
      'Corresponding source (GPL-3.0 section 6):' \
      '  /usr/share/doc/hauksbee/source/hauksbee-source.tar.gz' \
      '  /usr/share/doc/hauksbee/source/simavr-source.tar.gz' \
      > /usr/share/doc/hauksbee/LICENSE-BINARY.txt \
    && printf '%s\n' \
      'CORRESPONDING SOURCE OFFER' \
      '' \
      'Hauksbee and libsimavr form the GPL-3.0 combined binaries in this image.' \
      'For at least three years after this image version is distributed,' \
      'Hauksbee will provide any recipient the complete corresponding source' \
      'for the exact image digest on a durable medium for no more than the' \
      'physical cost of transfer. Request it at security@hauksbee.dev and name' \
      'the image digest. Preserve this offer when redistributing the image.' \
      > /usr/share/doc/hauksbee/SOURCE-OFFER.txt

USER hauksbee
WORKDIR /work

# No fixed ENTRYPOINT: both binaries are on PATH, so the command names the tool,
# e.g. `docker run hauksbee:slim hauksbee run board.kicad_pcb --report` or
# `... hauksbee-ci run spec.toml`. Mount your repo at /work (see docs/ci/DOCKER.md).
CMD ["hauksbee-ci", "--help"]
