(export (version "E")
  (design (source "Inkplate-class representative reconstruction (ESP32 + LiPo + 3V3 regulator topology). NOT the real Inkplate board: no native files exist. Pattern source: Inkplate 6 issues #7 / #10 (WiFi cold-boot brownout)."))
  (components
    (comp (ref "U1")
      (value "ESP32-WROOM-32")
      (footprint "RF_Module:ESP32-WROOM-32")
      (libsource (lib "RF_Module") (part "ESP32-WROOM-32")))
    (comp (ref "U2")
      (value "MCP1700")
      (footprint "Package_TO_SOT_SMD:SOT-23")
      (libsource (lib "Regulator_Linear") (part "MCP1700")))
    (comp (ref "C1")
      (value "10uF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (libsource (lib "Device") (part "C")))
    (comp (ref "C2")
      (value "10uF")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (libsource (lib "Device") (part "C")))
    (comp (ref "C3")
      (value "100nF")
      (footprint "Capacitor_SMD:C_0402_1005Metric")
      (libsource (lib "Device") (part "C")))
    (comp (ref "R1")
      (value "10k")
      (footprint "Resistor_SMD:R_0402_1005Metric")
      (libsource (lib "Device") (part "R")))
    (comp (ref "R2")
      (value "10k")
      (footprint "Resistor_SMD:R_0402_1005Metric")
      (libsource (lib "Device") (part "R")))
  )
  (nets
    (net (code "1") (name "VBAT")
      (node (ref "U2") (pin "3") (pinfunction "VIN") (pintype "power_in"))
      (node (ref "C1") (pin "1") (pintype "passive"))
    )
    (net (code "2") (name "+3.3V")
      (node (ref "U2") (pin "2") (pinfunction "VOUT") (pintype "power_out"))
      (node (ref "U1") (pin "2") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "C2") (pin "1") (pintype "passive"))
      (node (ref "C3") (pin "1") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive"))
    )
    (net (code "3") (name "GND")
      (node (ref "U2") (pin "1") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U1") (pin "1") (pinfunction "GND") (pintype "power_in"))
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "2") (pintype "passive"))
      (node (ref "C3") (pin "2") (pintype "passive"))
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "R2") (pin "2") (pintype "passive"))
    )
  )
)
