(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "+5V")
  (net 3 "A0")
  (net 4 "D0")
  (net 5 "D1")
  (net 6 "D2")
  (net 7 "D3")
  (net 8 "D4")
  (net 9 "D5")
  (net 10 "D6")
  (net 11 "D7")
  (net 12 "WE_N")
  (net 13 "OE_N")
  (net 14 "PASS")

  (module Package_DIP:DIP-28_W7.62mm (layer F.Cu)
    (at 100 100)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
    (fp_text value ATmega328P (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 1) (size 1 1) (net 2 "+5V"))
    (pad 2 thru_hole circle (at 0 2) (size 1 1) (net 1 "GND"))
    (pad 3 thru_hole circle (at 0 3) (size 1 1) (net 1 "GND"))
    (pad 4 thru_hole circle (at 0 4) (size 1 1) (net 12 "WE_N"))
    (pad 5 thru_hole circle (at 0 5) (size 1 1) (net 13 "OE_N"))
    (pad 6 thru_hole circle (at 0 6) (size 1 1) (net 1 "GND"))
    (pad 7 thru_hole circle (at 0 7) (size 1 1) (net 2 "+5V"))
    (pad 8 thru_hole circle (at 0 8) (size 1 1) (net 1 "GND"))
    (pad 9 thru_hole circle (at 0 9) (size 1 1) (net 1 "GND"))
    (pad 10 thru_hole circle (at 0 10) (size 1 1) (net 1 "GND"))
    (pad 11 thru_hole circle (at 0 11) (size 1 1) (net 1 "GND"))
    (pad 12 thru_hole circle (at 0 12) (size 1 1) (net 1 "GND"))
    (pad 13 thru_hole circle (at 0 13) (size 1 1) (net 1 "GND"))
    (pad 14 thru_hole circle (at 0 14) (size 1 1) (net 4 "D0"))
    (pad 15 thru_hole circle (at 0 15) (size 1 1) (net 5 "D1"))
    (pad 16 thru_hole circle (at 0 16) (size 1 1) (net 6 "D2"))
    (pad 17 thru_hole circle (at 0 17) (size 1 1) (net 7 "D3"))
    (pad 18 thru_hole circle (at 0 18) (size 1 1) (net 8 "D4"))
    (pad 19 thru_hole circle (at 0 19) (size 1 1) (net 9 "D5"))
    (pad 20 thru_hole circle (at 0 20) (size 1 1) (net 2 "+5V"))
    (pad 21 thru_hole circle (at 0 21) (size 1 1) (net 2 "+5V"))
    (pad 22 thru_hole circle (at 0 22) (size 1 1) (net 1 "GND"))
    (pad 23 thru_hole circle (at 0 23) (size 1 1) (net 3 "A0"))
    (pad 24 thru_hole circle (at 0 24) (size 1 1) (net 14 "PASS"))
    (pad 25 thru_hole circle (at 0 25) (size 1 1) (net 1 "GND"))
    (pad 26 thru_hole circle (at 0 26) (size 1 1) (net 1 "GND"))
    (pad 27 thru_hole circle (at 0 27) (size 1 1) (net 10 "D6"))
    (pad 28 thru_hole circle (at 0 28) (size 1 1) (net 11 "D7"))
  )

  (module Package_DIP:DIP-28_W15.24mm (layer F.Cu)
    (at 120 100)
    (fp_text reference U2 (at 0 0) (layer F.SilkS))
    (fp_text value AT28C256 (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 1) (size 1 1) (net 1 "GND"))
    (pad 2 thru_hole circle (at 0 2) (size 1 1) (net 1 "GND"))
    (pad 3 thru_hole circle (at 0 3) (size 1 1) (net 1 "GND"))
    (pad 4 thru_hole circle (at 0 4) (size 1 1) (net 1 "GND"))
    (pad 5 thru_hole circle (at 0 5) (size 1 1) (net 1 "GND"))
    (pad 6 thru_hole circle (at 0 6) (size 1 1) (net 1 "GND"))
    (pad 7 thru_hole circle (at 0 7) (size 1 1) (net 1 "GND"))
    (pad 8 thru_hole circle (at 0 8) (size 1 1) (net 1 "GND"))
    (pad 9 thru_hole circle (at 0 9) (size 1 1) (net 1 "GND"))
    (pad 10 thru_hole circle (at 0 10) (size 1 1) (net 3 "A0"))
    (pad 11 thru_hole circle (at 0 11) (size 1 1) (net 4 "D0"))
    (pad 12 thru_hole circle (at 0 12) (size 1 1) (net 5 "D1"))
    (pad 13 thru_hole circle (at 0 13) (size 1 1) (net 6 "D2"))
    (pad 14 thru_hole circle (at 0 14) (size 1 1) (net 1 "GND"))
    (pad 15 thru_hole circle (at 0 15) (size 1 1) (net 7 "D3"))
    (pad 16 thru_hole circle (at 0 16) (size 1 1) (net 8 "D4"))
    (pad 17 thru_hole circle (at 0 17) (size 1 1) (net 9 "D5"))
    (pad 18 thru_hole circle (at 0 18) (size 1 1) (net 10 "D6"))
    (pad 19 thru_hole circle (at 0 19) (size 1 1) (net 11 "D7"))
    (pad 20 thru_hole circle (at 0 20) (size 1 1) (net 1 "GND"))
    (pad 21 thru_hole circle (at 0 21) (size 1 1) (net 1 "GND"))
    (pad 22 thru_hole circle (at 0 22) (size 1 1) (net 13 "OE_N"))
    (pad 23 thru_hole circle (at 0 23) (size 1 1) (net 1 "GND"))
    (pad 24 thru_hole circle (at 0 24) (size 1 1) (net 1 "GND"))
    (pad 25 thru_hole circle (at 0 25) (size 1 1) (net 1 "GND"))
    (pad 26 thru_hole circle (at 0 26) (size 1 1) (net 1 "GND"))
    (pad 27 thru_hole circle (at 0 27) (size 1 1) (net 12 "WE_N"))
    (pad 28 thru_hole circle (at 0 28) (size 1 1) (net 2 "+5V"))
  )

  (module Resistor:R (layer F.Cu)
    (at 140 100)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 10k (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 0) (size 1 1) (net 14 "PASS"))
    (pad 2 thru_hole circle (at 0 2) (size 1 1) (net 1 "GND"))
  )
)
