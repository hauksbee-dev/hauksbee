(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "FLAG")
  (net 4 "SDA")
  (net 5 "SCL")
  (net 6 "PA5_OUT")

  (module Package_QFP:LQFP-48_7x7mm_P0.5mm (layer F.Cu)
    (at 100 100)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
    (fp_text value STM32F103C8T6 (at 0 2) (layer F.Fab))
    (pad 8  smd rect (at -3 1) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 1 "GND"))
    (pad 9  smd rect (at -3 2) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 2 "+3V3"))
    (pad 15 smd rect (at 3 0) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 6 "PA5_OUT"))
    (pad 29 smd rect (at 3 1) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 3 "FLAG"))
    (pad 23 smd rect (at 3 2) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 1 "GND"))
    (pad 24 smd rect (at 3 3) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 2 "+3V3"))
    (pad 35 smd rect (at -3 3) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 1 "GND"))
    (pad 36 smd rect (at -3 4) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 2 "+3V3"))
    (pad 42 smd rect (at -3 5) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 5 "SCL"))
    (pad 43 smd rect (at -3 6) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 4 "SDA"))
    (pad 44 smd rect (at -3 7) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 1 "GND"))
    (pad 48 smd rect (at -3 8) (size 0.6 0.6) (layers F.Cu F.Paste F.Mask) (net 2 "+3V3"))
  )

  (module Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm (layer F.Cu)
    (at 110 100)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 4k7 (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers *.Cu *.Mask) (net 3 "FLAG"))
    (pad 2 thru_hole circle (at 2 0) (size 1.6 1.6) (drill 0.8) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (segment (start 97 101) (end 95 101) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 97 103) (end 95 103) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 97 107) (end 95 107) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 95 107) (end 95 98) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 95 98) (end 112 98) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 112 98) (end 112 100) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 103 102) (end 112 102) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 112 102) (end 112 100) (width 0.25) (layer F.Cu) (net 1))
  (segment (start 97 102) (end 99 102) (width 0.25) (layer F.Cu) (net 2))
  (segment (start 97 104) (end 99 104) (width 0.25) (layer F.Cu) (net 2))
  (segment (start 97 108) (end 99 108) (width 0.25) (layer F.Cu) (net 2))
  (segment (start 99 102) (end 99 108) (width 0.25) (layer F.Cu) (net 2))
  (segment (start 99 103) (end 103 103) (width 0.25) (layer F.Cu) (net 2))
  (segment (start 103 101) (end 108 101) (width 0.25) (layer F.Cu) (net 3))
  (segment (start 108 101) (end 110 100) (width 0.25) (layer F.Cu) (net 3))
)
