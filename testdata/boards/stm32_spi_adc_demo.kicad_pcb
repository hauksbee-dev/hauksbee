(kicad_pcb (version 20171130) (host pcbnew 5.1.0)
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "FLAG")
  (net 4 "SPI1_SCK")
  (net 5 "SPI1_MISO")
  (net 6 "SPI1_MOSI")
  (net 7 "SPI1_NSS")

  (module Package_QFP:LQFP-48_7x7mm_P0.5mm (layer F.Cu)
    (at 100 100)
    (fp_text reference U1 (at 0 0) (layer F.SilkS))
    (fp_text value STM32F103C8T6 (at 0 2) (layer F.Fab))
    (pad 8  smd rect (at -3 0) (net 1 "GND"))
    (pad 9  smd rect (at -3 1) (net 2 "+3V3"))
    (pad 14 smd rect (at 3 0) (net 7 "SPI1_NSS"))
    (pad 15 smd rect (at 3 1) (net 4 "SPI1_SCK"))
    (pad 16 smd rect (at 3 2) (net 5 "SPI1_MISO"))
    (pad 23 smd rect (at -3 2) (net 1 "GND"))
    (pad 24 smd rect (at -3 3) (net 2 "+3V3"))
    (pad 29 smd rect (at 3 3) (net 3 "FLAG"))
    (pad 35 smd rect (at -3 4) (net 1 "GND"))
    (pad 36 smd rect (at -3 5) (net 2 "+3V3"))
    (pad 44 smd rect (at -3 6) (net 1 "GND"))
    (pad 48 smd rect (at -3 7) (net 2 "+3V3"))
  )

  (module Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm (layer F.Cu)
    (at 105 110)
    (fp_text reference R1 (at 0 0) (layer F.SilkS))
    (fp_text value 10k (at 0 2) (layer F.Fab))
    (pad 1 thru_hole circle (at 0 0) (net 3 "FLAG"))
    (pad 2 thru_hole circle (at 2 0) (net 1 "GND"))
  )
)
